# On Vercel the database values are set by the Neon integration. For local
# development, copy this file to .env.local and fill it in.

# Pooled connection string (host name contains "-pooler").
DATABASE_URL=
# Direct connection string, used for migrations.
DATABASE_URL_UNPOOLED=

# Signs sign-in sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Only needed locally.
BETTER_AUTH_URL=http://localhost:3000

# Manual library file storage: a private Cloudflare R2 bucket (see the
# README's "Manual library" section). Without these the library can still be
# searched, but manuals can't be added or opened.
# Cloudflare account ID (R2 > Overview, "Account ID").
R2_ACCOUNT_ID=
# An R2 API token with Object Read & Write on the bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Only for local testing against a stand-in server; leave unset otherwise.
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
