# On Vercel the database values are set by the Neon integration. For local
# development, copy this file to .env.local and fill it in.

# Pooled connection string (host name contains "-pooler").
DATABASE_URL=
# Direct connection string, used for migrations.
DATABASE_URL_UNPOOLED=

# Signs sign-in sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Only needed locally.
BETTER_AUTH_URL=http://localhost:3000
